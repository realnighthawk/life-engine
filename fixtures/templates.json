    {
      "id": "board.v1",
      "title": "Board",
      "description": "A screen of typed components for any task: a plan, a weekly review, a comparison, a status, a dashboard-like summary. An optional header gives a title or a one-line verdict; then an ordered list of sections, each one component: stats (tiles), moves (things to do with a state), watch (risks), steps (a timeline), callout (one highlighted note), facts (label and value pairs), table (a small comparison), bars (values compared by length), chart (a small line or column snapshot), progress (bars toward a goal), details (folded Markdown for method) and links (sources). Compose and repeat them as the task needs; lead with what matters most. Every component is an authored snapshot: a value that keeps changing belongs in a tracker or collection. Keep every slot short: a long explanation belongs in a document or a details section. The icons are check, swap, star, alert, clock, calendar, trend_up, trend_down, target, shield, bolt, flag, pin, money, user, trophy and heart; the tones are neutral, good, warn and risk.",
      "params_schema": {
        "type": "object",
        "properties": {
          "eyebrow": {
            "type": "string",
            "description": "a small line above the headline, up to 40 characters, such as GW12 · deadline Fri 18:30"
          },
          "headline": {
            "type": "string",
            "description": "optional: a verdict or title in one line, up to 90 characters"
          },
          "subline": {
            "type": "string",
            "description": "one supporting line, up to 140 characters"
          },
          "tone": {
            "type": "string",
            "description": "colours the header: neutral (default), good, warn or risk"
          },
          "icon": {
            "type": "string",
            "description": "one of the board icons, drawn beside the headline"
          },
          "sections": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "description": "stable lowercase identifier, unique within the board"
                },
                "kind": {
                  "type": "string",
                  "description": "stats, moves, watch, steps, callout, facts, table, bars, chart, progress, details or links"
                },
                "title": {
                  "type": "string",
                  "description": "a small heading above the component, up to 40 characters; omit for the component's own default"
                },
                "stats": {
                  "type": [
                    "null",
                    "array"
                  ],
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "description": "stable lowercase identifier, unique within the board"
                      },
                      "label": {
                        "type": "string",
                        "description": "what the number is, up to 20 characters"
                      },
                      "value": {
                        "type": "string",
                        "description": "the figure as shown, up to 12 characters, such as +12.9 or 5th"
                      },
                      "note": {
                        "type": "string",
                        "description": "a few words under the value, up to 24 characters"
                      },
                      "icon": {
                        "type": "string",
                        "description": "one of the board icons"
                      },
                      "tone": {
                        "type": "string",
                        "description": "neutral (default), good, warn or risk"
                      }
                    },
                    "required": [
                      "id",
                      "label",
                      "value"
                    ],
                    "additionalProperties": false
                  },
                  "description": "kind stats: 1-4 tiles"
                },
                "moves": {
                  "type": [
                    "null",
                    "array"
                  ],
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "description": "stable lowercase identifier, unique within the board"
                      },
                      "title": {
                        "type": "string",
                        "description": "the action, up to 60 characters"
                      },
                      "detail": {
                        "type": "string",
                        "description": "one short reason, up to 80 characters"
                      },
                      "state": {
                        "type": "string",
                        "description": "todo (default), done or hold"
                      },
                      "icon": {
                        "type": "string",
                        "description": "one of the board icons"
                      },
                      "tag": {
                        "type": "string",
                        "description": "a small label such as a deadline, up to 16 characters"
                      }
                    },
                    "required": [
                      "id",
                      "title"
                    ],
                    "additionalProperties": false
                  },
                  "description": "kind moves: 1-8 things to do, in order"
                },
                "watch": {
                  "type": [
                    "null",
                    "array"
                  ],
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "description": "stable lowercase identifier, unique within the board"
                      },
                      "title": {
                        "type": "string",
                        "description": "the risk, up to 60 characters"
                      },
                      "detail": {
                        "type": "string",
                        "description": "one short note, up to 80 characters"
                      },
                      "level": {
                        "type": "string",
                        "description": "info, warn (default) or risk"
                      },
                      "icon": {
                        "type": "string",
                        "description": "one of the board icons"
                      }
                    },
                    "required": [
                      "id",
                      "title"
                    ],
                    "additionalProperties": false
