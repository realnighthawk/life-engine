    {
      "id": "brief.v1",
      "title": "Brief",
      "description": "A decision screen drawn mostly with icons, tone and tiles: a one-line verdict, up to 4 stat tiles, the moves to make, what to watch, what is ahead, folded notes and sources. Choose it for a plan or a weekly decision the person acts on and returns to. Keep every slot short; a long explanation belongs in a document or a folded detail. The icons are check, swap, star, alert, clock, calendar, trend_up, trend_down, target, shield, bolt, flag, pin, money, user, trophy and heart.",
      "params_schema": {
        "type": "object",
        "properties": {
          "eyebrow": {
            "type": "string",
            "description": "a small line above the headline, up to 40 characters, such as GW12 · deadline Fri 18:30"
          },
          "headline": {
            "type": "string",
            "description": "the verdict in one line, 1-90 characters"
          },
          "subline": {
            "type": "string",
            "description": "one supporting line, up to 140 characters"
          },
          "tone": {
            "type": "string",
            "description": "colours the header: neutral (default), good, warn or risk"
          },
          "icon": {
            "type": "string",
            "description": "one of the brief icons, drawn beside the headline"
          },
          "stats": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "description": "stable lowercase identifier, unique within the brief"
                },
                "label": {
                  "type": "string",
                  "description": "what the number is, up to 20 characters"
                },
                "value": {
                  "type": "string",
                  "description": "the figure as shown, up to 12 characters, such as +12.9 or 5th"
                },
                "note": {
                  "type": "string",
                  "description": "a few words under the value, up to 24 characters"
                },
                "icon": {
                  "type": "string",
                  "description": "one of the brief icons"
                },
                "tone": {
                  "type": "string",
                  "description": "neutral (default), good, warn or risk"
                }
              },
              "required": [
                "id",
                "label",
                "value"
              ],
              "additionalProperties": false
            },
            "description": "up to 4 tiles"
          },
          "moves": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "description": "stable lowercase identifier, unique within the brief"
                },
                "title": {
                  "type": "string",
                  "description": "the action, up to 60 characters"
                },
                "detail": {
                  "type": "string",
                  "description": "one short reason, up to 80 characters"
                },
                "state": {
                  "type": "string",
                  "description": "todo (default), done or hold"
                },
                "icon": {
                  "type": "string",
                  "description": "one of the brief icons"
                },
                "tag": {
                  "type": "string",
                  "description": "a small label such as a deadline, up to 16 characters"
                }
              },
              "required": [
                "id",
                "title"
              ],
              "additionalProperties": false
            },
            "description": "up to 8 things to do"
          },
          "watch": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "description": "stable lowercase identifier, unique within the brief"
                },
                "title": {
                  "type": "string",
                  "description": "the risk, up to 60 characters"
                },
                "detail": {
                  "type": "string",
                  "description": "one short note, up to 80 characters"
                },
                "level": {
                  "type": "string",
                  "description": "info, warn (default) or risk"
                },
                "icon": {
                  "type": "string",
                  "description": "one of the brief icons"
                }
              },
              "required": [
                "id",
                "title"
              ],
              "additionalProperties": false
            },
            "description": "up to 6 things that could change the plan"
          },
          "ahead": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "description": "stable lowercase identifier, unique within the brief"
                },
                "label": {
                  "type": "string",
                  "description": "when, up to 16 characters, such as GW15 or Jan"
                },
                "title": {
                  "type": "string",
                  "description": "what happens, up to 48 characters"
                },
                "icon": {
                  "type": "string",
                  "description": "one of the brief icons"
                },
                "tone": {
                  "type": "string",
                  "description": "neutral (default), good, warn or risk"
                }
              },
              "required": [
                "id",
                "label",
                "title"
              ],
              "additionalProperties": false
            },
            "description": "up to 8 upcoming steps, in order"
          },
          "details": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "description": "stable lowercase identifier, unique within the brief"
                },
                "title": {
                  "type": "string",
                  "description": "1-40 characters; shown folded"
                },
                "markdown": {
                  "type": "string",
                  "description": "authored Markdown, 1-4096 bytes; rendered without raw HTML"
                }
              },
              "required": [
                "id",
                "title",
                "markdown"
              ],
              "additionalProperties": false
            },
            "description": "up to 4 folded notes for the method or reasoning"
          },
          "links": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "description": "stable lowercase identifier, unique within the brief"
                },
                "title": {
                  "type": "string",
                  "description": "up to 60 characters"
                },
                "url": {
                  "type": "string",
                  "description": "an http or https address to open"
                }
              },
              "required": [
                "id",
                "title",
                "url"
              ],
              "additionalProperties": false
            },
            "description": "up to 6 sources"
          }
        },
        "required": [
          "headline"
        ],
        "additionalProperties": false
      },
      "example": {
        "eyebrow": "GW12 · deadline Fri 18:30",
        "headline": "Swap Raya for Trafford. Roll the other transfer.",
        "subline": "Raya is 50% fit; Leeds have the best clean-sheet odds.",
        "tone": "good",
        "icon": "swap",
        "stats": [
          {
            "id": "gain",
            "label": "5-week gain",
            "value": "+12.9",
            "note": "from one transfer",
            "icon": "trend_up",
            "tone": "good"
          },
          {
            "id": "rank",
            "label": "League rank",
            "value": "5th",
            "note": "31 behind 2nd"
          },
          {
            "id": "ft",
            "label": "Free transfers",
            "value": "1",
            "note": "rolled to next week",
            "icon": "swap"
          }
        ],
        "moves": [
          {
            "id": "gk",
            "title": "Raya to Trafford",
            "detail": "Raya 12.0 vs Trafford 24.9 points",
            "icon": "swap",
            "tag": "before Fri"
          },
          {
            "id": "cap",
            "title": "Captain Groß",
            "detail": "6.2 expected, Haaland 5.6 away",
            "icon": "star"
          },
          {
            "id": "roll",
            "title": "Keep the second transfer",
            "state": "hold",
            "icon": "clock"
          }
        ],
        "watch": [
          {
            "id": "raya",
            "title": "Raya is 50% fit",
            "level": "risk",
            "icon": "heart"
          },
          {
            "id": "cards",
            "title": "Three players on four yellows",
            "detail": "A fifth is a ban",
            "level": "warn",
            "icon": "alert"
          }
        ],
        "ahead": [
          {
            "id": "tc",
            "label": "GW15",
            "title": "Triple Captain, Haaland at home",
            "icon": "bolt",
            "tone": "good"
          },
          {
            "id": "expiry",
            "label": "GW19",
            "title": "First chip set expires",
            "icon": "calendar",
            "tone": "warn"
          }
        ],
        "details": [
          {
            "id": "method",
            "title": "How this was scored",
            "markdown": "Five gameweeks of fixtures, half underlying stats and half results."
          }
        ],
        "links": [
          {
            "id": "rotowire",
            "title": "RotoWire GW12 rankings",
            "url": "https://www.rotowire.com/soccer/"
          }
        ]
      },
      "clients": [
        "web",
        "ios"
      ]
    },
    {
      "id": "collection.v1",
      "title": "Collection",
      "description": "A list or table of records the person can act on: chores, a shopping list, bookings, open items. The source returns the records; each action calls the same app (for example marking one done).",
      "params_schema": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string",
            "description": "the id of one of the artifact's sources; it returns the items"
          },
          "layout": {
            "type": "string",
            "description": "list shows the first column as the title, the second as the subtitle and the rest beside it; table shows every column"
          },
          "columns": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "object",
              "properties": {
                "key": {
                  "type": "string",
                  "description": "the field of each item this column shows; lowercase identifier"
                },
                "label": {
                  "type": "string",
                  "description": "column heading, up to 24 characters"
                },
                "format": {
                  "type": "string",
                  "description": "text (default), number, money, percent, date or status"
                }
              },
              "required": [
                "key",
                "label"
              ],
              "additionalProperties": false
            },
            "description": "1-8 columns, in order"
          },
          "empty": {
            "type": "string",
            "description": "what to say when there are no items, up to 120 characters"
          },
          "actions": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "description": "lowercase identifier, unique among the actions"
                },
                "label": {
                  "type": "string",
                  "description": "button text, up to 24 characters"
                },
                "method": {
                  "type": "string",
                  "description": "POST or DELETE"
                },
                "path": {
                  "type": "string",
                  "description": "a path on the source's app with {id} replaced by the row's id, such as /items/{id}/done"
                },
                "confirm": {
                  "type": "boolean",
                  "description": "ask the person before sending"
                },
                "destructive": {
                  "type": "boolean",
                  "description": "draw it as a destructive action"
                }
              },
              "required": [
                "id",
                "label",
                "method",
                "path"
              ],
              "additionalProperties": false
            },
            "description": "up to 4 actions offered on every row"
          }
        },
        "required": [
          "source",
          "layout",
          "columns"
        ],
        "additionalProperties": false
      },
      "data_contract": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "id"
              ],
              "additionalProperties": {
                "type": [
                  "string",
                  "number",
                  "boolean",
                  "null"
                ]
              }
            },
            "maxItems": 500
          }
        },
        "required": [
          "items"
        ]
      },
      "example": {
        "source": "chores",
        "layout": "list",
        "columns": [
          {
            "key": "title",
            "label": "Chore"
          },
          {
            "key": "due",
            "label": "Due",
            "format": "date"
          },
          {
            "key": "status",
            "label": "Status",
            "format": "status"
          }
        ],
        "empty": "Nothing to do.",
        "actions": [
          {
            "id": "done",
            "label": "Done",
            "method": "POST",
            "path": "/chores/{id}/done"
          }
        ]
      },
      "example_sources": [
        {
          "id": "chores",
          "url": "life-app://chores/chores"
        }
      ],
      "data_example": {
        "items": [
          {
            "id": "c1",
            "title": "Water the plants",
            "due": "2026-11-22",
            "status": "open"
          },
          {
            "id": "c2",
            "title": "Take out the bins",
            "due": "2026-11-23",
            "status": "open"
          }
        ]
      },
      "clients": [
        "web",
        "ios"
      ]
    },
    {
      "id": "tracker.v1",
      "title": "Tracker",
      "description": "One measurement over time, drawn as a chart with an optional target, plus an optional form that logs a new value: weight, spend, a habit count. The source returns the points; the form posts to the same app.",
      "params_schema": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string",
            "description": "the id of one of the artifact's sources; it returns the series"
          },
          "unit": {
            "type": "string",
            "description": "what a value is measured in, up to 24 characters"
          },
          "target": {
            "type": [
              "null",
              "number"
            ],
            "description": "a value to draw a line at"
          },
          "days": {
            "type": "integer",
            "description": "how many recent days to show, 1-366; default 30"
          },
          "log": {
            "type": [
              "null",
              "object"
            ],
            "properties": {
              "label": {
                "type": "string",
                "description": "the form's button text, up to 24 characters"
              },
              "path": {
                "type": "string",
                "description": "a path on the source's app that receives the form as a JSON POST, such as /log"
              },
              "fields": {
                "type": [
                  "null",
                  "array"
                ],
                "items": {
                  "type": "object",
                  "properties": {
                    "key": {
                      "type": "string",
                      "description": "the field name sent to the app; lowercase identifier"
                    },
                    "label": {
                      "type": "string",
                      "description": "up to 24 characters"
                    },
                    "kind": {
                      "type": "string",
                      "description": "number, text or date"
                    },
                    "required": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "key",
                    "label",
                    "kind"
                  ],
                  "additionalProperties": false
                },
                "description": "1-4 fields"
              }
            },
            "description": "a form that records a new value; omit for a read-only tracker",
            "required": [
              "label",
              "path",
              "fields"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "source"
        ],
        "additionalProperties": false
      },
      "data_contract": {
        "type": "object",
        "properties": {
          "points": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "at": {
                  "type": "string",
                  "description": "a date (2026-11-21) or an RFC 3339 time",
                  "minLength": 8
                },
                "value": {
                  "type": "number"
                }
              },
              "required": [
                "at",
                "value"
              ]
            },
            "maxItems": 2000
          }
        },
        "required": [
          "points"
        ]
      },
      "example": {
        "source": "weight",
        "unit": "kg",
        "target": 72,
        "days": 30,
        "log": {
          "label": "Log weight",
          "path": "/log",
          "fields": [
            {
              "key": "value",
              "label": "Weight",
              "kind": "number",
              "required": true
            },
            {
              "key": "note",
              "label": "Note",
              "kind": "text"
            }
          ]
        }
      },
      "example_sources": [
        {
          "id": "weight",
          "url": "life-app://weight/series"
        }
      ],
      "data_example": {
        "points": [
          {
            "at": "2026-11-01",
            "value": 75.2
          },
          {
            "at": "2026-11-08",
            "value": 74.6
          },
          {
