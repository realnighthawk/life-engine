                  "required": [
                    "text"
                  ],
                  "additionalProperties": false
                },
                "facts": {
                  "type": [
                    "null",
                    "array"
                  ],
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
