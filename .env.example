# Private PostgreSQL database owned by Life Engine; plain PostgreSQL, no extensions required.
DATABASE_URL=postgres://lifeengine:replace-me@127.0.0.1:5432/lifeengine?sslmode=disable
LISTEN_ADDR=127.0.0.1:8093
# Comma-separated browser origins allowed to POST; https://*.domain wildcards are supported.
TRUSTED_ORIGINS=

# Attachments (added with the attachments work package): all four or none.
# MINIO_ENDPOINT=http://127.0.0.1:9000
# MINIO_BUCKET=life-attachments
# MINIO_ACCESS_KEY=replace-me
# MINIO_SECRET_KEY=replace-me
