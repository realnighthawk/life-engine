# Private PostgreSQL database owned by Life Engine; plain PostgreSQL, no extensions required.
DATABASE_URL=postgres://lifeengine:replace-me@127.0.0.1:5432/lifeengine?sslmode=disable
LISTEN_ADDR=127.0.0.1:8093
# Comma-separated browser origins allowed to POST; https://*.domain wildcards are supported.
TRUSTED_ORIGINS=

# Alerts: set both to arm Temporal Schedules for items with an alert and run the worker that fires them (without them items
# are stored and nothing fires them). TEMPORAL_NAMESPACE defaults to agents, TEMPORAL_WORKFLOW_TASK_QUEUE (the harness's
# session coordinators) to agent-loop, LIFE_ENGINE_TASK_QUEUE (this engine's own worker) to life-engine.
# TEMPORAL_ADDRESS=temporal-frontend:7233
# TENANT_SLUG=acme
